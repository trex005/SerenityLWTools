{
  "name": "lw-serenity",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:engine": "esbuild lib/serenity-engine/index.ts --bundle --format=iife --global-name=LWSerenityEngine --platform=neutral --target=es2020 --outfile=artifacts/lw-serenity-engine.js",
    "check:engine": "node scripts/check-engine-artifact.mjs",
    "test:tz": "tsx --test lib/date-utils.test.ts",
    "test:recurrence": "tsx --test lib/recurrence-utils.test.ts",
    "test:engine": "tsx --test lib/serenity-engine/*.test.ts lib/serenity-engine/reports/*.test.ts",
    "test:config": "tsx --test lib/config-fetcher.test.ts",
    "test:storage": "tsx --test lib/scoped-storage.test.ts",
    "test:migrate": "tsx --test scripts/migrate-dates.test.ts",
    "test:converter": "tsx --test scripts/convert-tag-schema.test.ts",
    "test:date-scoped": "tsx --test lib/date-scoped-config.test.ts lib/local-event-operations.test.ts lib/event-operation-diff.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.712.0",
    "@aws-sdk/client-s3": "^3.712.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.454.0",
    "next-themes": "^0.4.4",
    "react": "^19",
    "react-dom": "^19",
    "react-intersection-observer": "^9.14.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.0.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.28.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vite": "^6.0.7"
  }
}
